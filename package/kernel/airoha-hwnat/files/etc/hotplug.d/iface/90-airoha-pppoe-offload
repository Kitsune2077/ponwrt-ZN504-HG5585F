#!/bin/sh
# Interface hotplug hook for Airoha HW NAT and PPPoE offload
# Triggers on WAN / PPPoE connect events to prime hardware flow tables

[ "$ACTION" = "ifup" ] || exit 0

case "$INTERFACE" in
	wan|wan6|pppoe-wan|*wan*)
		[ -x /etc/init.d/airoha-hwnat ] && /etc/init.d/airoha-hwnat reload
		;;
esac
